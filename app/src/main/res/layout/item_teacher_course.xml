<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 左侧：课程封面图 -->
        <FrameLayout
            android:id="@+id/teacherCourseImageContainer"
            android:layout_width="130dp"
            android:layout_height="match_parent"
            android:minHeight="160dp">

            <ImageView
                android:id="@+id/teacherCourseCoverImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/teacherCourseIconText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="📘"
                android:textSize="36sp"
                android:gravity="center"
                android:background="@color/light_gray_background" />

        </FrameLayout>

        <!-- 右侧：课程信息 + 按钮 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="10dp"
            android:gravity="center_vertical">

            <!-- 课程名称 -->
            <TextView
                android:id="@+id/teacherCourseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="课程名称"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tsinghua_purple_dark"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="2dp" />

            <!-- 课程描述 -->
            <TextView
                android:id="@+id/teacherCourseDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="课程描述"
                android:textSize="12sp"
                android:textColor="#666666"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <!-- 教师 + 时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/teacherCourseTeacher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="教师："
                    android:textSize="11sp"
                    android:textColor="#999999" />

                <TextView
                    android:id="@+id/teacherCourseDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="创建："
                    android:textSize="11sp"
                    android:textColor="#999999" />

            </LinearLayout>

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginBottom="6dp" />

            <!-- 四个功能按钮：2行x2列紧凑布局 -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignBounds"
                android:columnOrderPreserved="false">

                <!-- 播放视频 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/playVideoBtn"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/tsinghua_purple"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▶"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:layout_marginEnd="3dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="播放"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:maxLines="1" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- 管理题目 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/manageQuestionsBtn"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F3EDF7"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📝"
                            android:textSize="12sp"
                            android:layout_marginEnd="3dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="题目"
                            android:textSize="12sp"
                            android:textColor="@color/tsinghua_purple"
                            android:maxLines="1" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- 上传资料 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/uploadMaterialBtn"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="0dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFF3E0"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📎"
                            android:textSize="12sp"
                            android:layout_marginEnd="3dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="资料"
                            android:textSize="12sp"
                            android:textColor="#E65100"
                            android:maxLines="1" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- 删除课程 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/deleteCourseBtn"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="0dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFEBEE"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✕"
                            android:textSize="12sp"
                            android:textColor="#C62828"
                            android:layout_marginEnd="3dp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="删除"
                            android:textSize="12sp"
                            android:textColor="#C62828"
                            android:maxLines="1" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </GridLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
