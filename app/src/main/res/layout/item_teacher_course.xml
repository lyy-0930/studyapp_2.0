<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 左侧：课程封面图 -->
        <FrameLayout
            android:id="@+id/teacherCourseImageContainer"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:minHeight="150dp">

            <ImageView
                android:id="@+id/teacherCourseCoverImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/teacherCourseIconText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="📘"
                android:textSize="40sp"
                android:gravity="center"
                android:background="@color/light_gray_background" />

        </FrameLayout>

        <!-- 右侧：课程信息 + 按钮 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- 课程名称 -->
            <TextView
                android:id="@+id/teacherCourseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="课程名称"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/tsinghua_purple_dark"
                android:layout_marginBottom="4dp" />

            <!-- 课程描述 -->
            <TextView
                android:id="@+id/teacherCourseDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="课程描述"
                android:textSize="13sp"
                android:textColor="#666666"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="6dp" />

            <!-- 授课教师 + 创建时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/teacherCourseTeacher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="教师："
                    android:textSize="12sp"
                    android:textColor="#999999" />

                <TextView
                    android:id="@+id/teacherCourseDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="创建时间："
                    android:textSize="12sp"
                    android:textColor="#999999" />

            </LinearLayout>

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginBottom="8dp" />

            <!-- 四个功能按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/playVideoBtn"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="播放视频"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/tsinghua_purple"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="2dp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/manageQuestionsBtn"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="管理题目"
                    android:textSize="11sp"
                    android:textColor="@color/tsinghua_purple"
                    android:backgroundTint="#F0E6F6"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="2dp"
                    android:ellipsize="end"
                    android:singleLine="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/uploadMaterialBtn"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="上传资料"
                    android:textSize="11sp"
                    android:textColor="@color/tsinghua_purple"
                    android:backgroundTint="#F0E6F6"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="2dp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/deleteCourseBtn"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="删除课程"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:backgroundTint="#FF6B6B"
                    android:paddingHorizontal="2dp"
                    android:ellipsize="end"
                    android:singleLine="true" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
