<?xml version="1.0" encoding="utf-8"?>
<!-- 教师/管理员 志愿推文 列表/管理，嵌在两端的壳内：透明底 + 白卡片，兼容两端灰/白底 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/articleScrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingHorizontal="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题行：标题 + 发布 + 刷新 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/articlePageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📰  志愿推文"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/tsinghua_purple_dark" />

            <TextView
                android:id="@+id/publishButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="10dp"
                android:text="＋ 发布"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_article_publish"
                android:visibility="gone"
                tools:text="＋ 发布" />

            <ImageButton
                android:id="@+id/articleRefreshButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_refresh"
                android:background="@drawable/ic_button_background_selector"
                android:contentDescription="刷新"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <!-- 说明文案（管理模式显示数据范围提示） -->
        <TextView
            android:id="@+id/captionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/darker_gray"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- 文章卡片列表（逐条 addView，每条自含白色圆角卡片） -->
        <LinearLayout
            android:id="@+id/articleRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="24dp" />

        <!-- 空态 / 加载失败提示 -->
        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="36dp"
            android:textSize="15sp"
            android:textColor="#FF666666"
            android:visibility="gone"
            tools:text="还没有任何推文" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
