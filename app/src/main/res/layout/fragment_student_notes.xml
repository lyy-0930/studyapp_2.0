<?xml version="1.0" encoding="utf-8"?>
<!-- 教师/管理员 学生笔记 三级浏览（学生 → 课程 → 笔记），嵌在两端的壳内：透明底 + 白卡片，兼容两端灰/白底 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notesScrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingHorizontal="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题行：标题 + 刷新 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/notesPageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📓  学生笔记"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/tsinghua_purple_dark" />

            <ImageButton
                android:id="@+id/notesRefreshButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_refresh"
                android:background="@drawable/ic_button_background_selector"
                android:contentDescription="刷新"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <!-- 角色说明（教师=我课程里的学生；管理员=全部学生） -->
        <TextView
            android:id="@+id/roleCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/darker_gray"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp" />

        <!-- 三级列表内容（学生层 / 课程层 / 笔记层共用） -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:id="@+id/noteRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 空态 / 加载失败提示 -->
                <TextView
                    android:id="@+id/emptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="36dp"
                    android:textSize="15sp"
                    android:textColor="#FF666666"
                    android:visibility="gone"
                    tools:text="还没有学生写过笔记" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
